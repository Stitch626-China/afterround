# 复制为 .env 后按需修改：cp .env.example .env
# .env 已被 .gitignore 排除，禁止提交真实密钥。

# ---------- 数据库 ----------
DB_PASSWORD=change-me-postgres-password

# ---------- 安全 ----------
# AES-GCM 主密钥，用于加密存取 Provider 的 API Key（FRX.10）
# 生成方式示例：openssl rand -base64 32
# 注意：此密钥丢失将导致已保存的 API Key 无法解密，需重新录入
APP_SECRET_KEY=

# ---------- 文件存储 ----------
# 本地磁盘根目录（FR1.4），容器内由 compose 映射到 appdata 卷
STORAGE_ROOT=./data/files

# ---------- 异步线程池（§6.3：有界，避免触发厂商限流） ----------
ASYNC_CORE_POOL_SIZE=2
ASYNC_MAX_POOL_SIZE=4
ASYNC_QUEUE_CAPACITY=20
# ASR 长任务独立线程池（FR4.8）
ASYNC_ASR_CORE_POOL_SIZE=1
ASYNC_ASR_MAX_POOL_SIZE=2
ASYNC_ASR_QUEUE_CAPACITY=5

# ---------- 语音转写（FR4.1，可选） ----------
# OpenAI 兼容 /audio/transcriptions；base-url 需包含 /v1（如 https://api.openai.com/v1）
# 未配置时音频复盘不可用，接口会提示改用「转写文本 / 手动笔记」
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=whisper-1
ASR_LANGUAGE=zh
ASR_TIMEOUT_SECONDS=600

# ---------- 模型配置种子（首次启动且库内为空时导入一次） ----------
# 日常请在「模型设置」页面维护，无需改这里
LLM_BOOTSTRAP_PROVIDER_KEY=
LLM_BOOTSTRAP_LABEL=
LLM_BOOTSTRAP_BASE_URL=
LLM_BOOTSTRAP_API_KEY=
LLM_BOOTSTRAP_MODEL=

# ---------- 单次调用 token 硬上限（NFR7） ----------
LLM_MAX_TOKENS=4096

# ---------- 场景评测（LLM 工作台「评测运行」使用，可选） ----------
# 评测语料比日常输入长，单独放宽 token 与超时，不影响生产调用的 4096 / 120s
EVAL_MAX_TOKENS=8192
EVAL_TIMEOUT_SECONDS=300
# 默认重复次数；>1 时同一用例跑多次用于稳定性观察
EVAL_REPEAT=1

# ---------- 对话上下文最多携带的历史消息条数 ----------
LLM_MAX_HISTORY_MESSAGES=50
